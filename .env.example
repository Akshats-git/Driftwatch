# Environment variables used across this project's packages (apps/web,
# packages/ingestion, packages/db, ...). Copy to .env and fill in real
# values — .env is gitignored, this file is the tracked reference.
#
#   cp .env.example .env

# --- Data ingestion ---

# Bright Data API key. Powers the scraping/proxy layer packages/ingestion
# uses to collect the pages/data being watched for drift.
# Get it from: Bright Data dashboard -> Account settings -> API key
# (brightdata.com).
BRIGHTDATA_API_KEY=

# --- Database ---

# Postgres connection string (Supabase). Used by packages/db (Drizzle ORM)
# for migrations and queries. Use the direct connection (port 5432), not
# the pgbouncer/transaction pooler one — drizzle-kit's migrator needs a
# non-pooled connection.
# Get it from: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- AI ---

# Anthropic API key. Used for Claude-powered analysis of ingested data
# (e.g. summarizing or classifying detected changes).
# Get it from: console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# --- Notifications ---

# Slack incoming webhook URL. Used to post drift/alert notifications to a
# Slack channel.
# Get it from: api.slack.com/apps -> your app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Discord channel webhook URL. Same purpose as SLACK_WEBHOOK_URL, for
# Discord instead.
# Get it from: Discord channel Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# --- Deployment ---

# GitHub personal access token. Used for GitHub API access (CI automation,
# release/deploy scripts, etc.).
# Get it from: GitHub -> Settings -> Developer settings -> Personal access
# tokens.
GITHUB_TOKEN=

# Vercel API token. Used to deploy/manage apps/web on Vercel.
# Get it from: Vercel dashboard -> Account Settings -> Tokens.
VERCEL_TOKEN=

# Fly.io API token. Used to deploy packages/ingestion (deployed
# independently of apps/web) to Fly.io.
# Get it from: `fly auth token` (Fly CLI), or Fly.io dashboard -> Account
# -> Access Tokens.
FLY_API_TOKEN=
